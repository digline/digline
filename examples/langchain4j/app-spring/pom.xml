<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.digline.example</groupId>
  <artifactId>support-assistant</artifactId>
  <version>0.1.0</version>
  <name>support-assistant</name>
  <description>A LangChain4j service with one endpoint digline can evaluate.</description>

  <properties>
    <java.version>21</java.version>
    <langchain4j.version>1.20.2</langchain4j.version>
    <!-- Ahead of what this Spring Boot manages. Three advisories against
         Tomcat 11.0.24 are fixed in 11.0.25, and a demo that ships known-
         vulnerable transitives is a demo teaching the wrong thing. Dependabot
         watches this property like any other; it goes away when Spring Boot's
         own managed version passes it. -->
    <tomcat.version>11.0.25</tomcat.version>
    <!-- The same, for both jackson-databind lines this Spring Boot pulls in.
         Three advisories published 2026-09-28 (GHSA-q4xh-88c3-wmh7,
         GHSA-wjgm-6hv5-3cvf, GHSA-gx83-3vf8-gh7j) are fixed in 2.21.6 and
         3.1.6; Spring Boot 4.1.1 manages 2.21.5 and 3.1.5. GitHub's dependency
         graph reads only this pom's direct dependencies, so it never saw
         them: they reached this repository through Scorecard alone.
         Raised again for two more, published 2026-09-30 (GHSA-cxp5-3px4-pw24,
         GHSA-wv8q-qhhj-9h54) and fixed in 2.21.7 and 3.1.7. The same route:
         Scorecard listed them within the hour, and Dependabot raised nothing,
         because the graph still holds no jackson-databind for this pom. -->
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- The prompt is shared with app-quarkus and lives one level up: it is
           the thing under test, and it must not belong to either framework.
           `suite.py` names ../prompts/system.txt as the run's artifact, and
           there is exactly one copy for both services to package. -->
      <resource>
        <directory>${project.basedir}/../prompts</directory>
        <targetPath>prompts</targetPath>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
