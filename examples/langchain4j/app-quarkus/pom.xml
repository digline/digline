<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.digline.example</groupId>
  <artifactId>support-assistant-quarkus</artifactId>
  <version>0.1.0</version>
  <name>support-assistant-quarkus</name>
  <description>The same endpoint as app-spring, on Quarkus. Same contract, same prompt.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.39.5</quarkus.platform.version>
    <quarkus-langchain4j.version>1.14.0</quarkus-langchain4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Jackson's own BOM, ahead of what this Quarkus manages, and
           declared before quarkus-bom so it wins: of two imported BOMs, the
           first one declared wins. quarkus-bom 3.39.5 manages Jackson at
           2.22.2.
           Two advisories published 2026-09-30 (GHSA-cxp5-3px4-pw24,
           GHSA-wv8q-qhhj-9h54) were fixed in jackson-databind 2.22.3. The
           3.40.1 BOM would fix them too, but by moving back from the 2.22
           line to 2.21.7, a minor line backwards for a patch.
           **Why the whole BOM and not one artifact.** On 2026-09-30 this
           pinned jackson-databind alone. On 2026-10-01 two advisories arrived
           against its sibling, jackson-core (GHSA-7hhh-6rmp-j9qf,
           GHSA-p6pp-m3f8-5c89, fixed in 2.22.3), which the single pin left at
           the BOM's 2.22.2. app-spring pins the whole BOM and did not have
           them. A pin on one artifact covers one advisory; the BOM covers
           the class, every Jackson artifact moving together.
           They reached this repository through Scorecard alone. GitHub's
           dependency graph reads only this pom's direct dependencies, which
           name no Jackson artifact, so Dependabot raised nothing. This pin
           goes away when quarkus-bom's own managed version passes it. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.22.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JAX-RS and JSON: the endpoint digline posts to. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- The same LangChain4j underneath, wired by the extension rather than
         built by hand: that difference is the whole point of the pair. -->
    <dependency>
      <groupId>io.quarkiverse.langchain4j</groupId>
      <artifactId>quarkus-langchain4j-openai</artifactId>
      <version>${quarkus-langchain4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- The prompt is shared with app-spring and lives one level up: it is
           the thing under test, and it must not belong to either framework. -->
      <resource>
        <directory>${project.basedir}/../prompts</directory>
        <targetPath>prompts</targetPath>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
