<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only for the tests. The files under src/main/java are copied into an
  application, not published: nothing is built from this project but the
  tests the CI job `recorder-java` runs (ADR 0062 §4).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.digline</groupId>
  <artifactId>digline-recorder-java-tests</artifactId>
  <version>0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!--
    Versions the SDKs below bring and that carry advisories, raised here
    because no release of the SDK raises them (Scorecard alert 8, read
    2026-11-09). openai-java 4.101.0, the newest on that day, still declares
    jackson-core and jackson-databind 2.18.9, fixed in 2.18.11; anthropic-java
    3.6.0 still declares opentelemetry-api 1.62.0, fixed in 1.67.0. Each entry
    goes when the SDK that brings it declares the fixed version or later.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>2.18.11</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.18.11</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-api</artifactId>
        <version>1.67.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      What the hooks hook. ADR 0062 read openai-java 4.99.0, anthropic-java
      3.4.0 and bedrockruntime 2.42.41 on 2026-11-04; what CI runs is what is
      written here, and Dependabot moves it. OkHttp stays at the major
      openai-java brings: OkHttp 5's Maven artifact carries none of the
      okhttp3 or okio classes the hook compiles against.
    -->
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>4.99.0</version>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>4.12.1</version>
    </dependency>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>3.4.0</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>bedrockruntime</artifactId>
      <version>2.57.8</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-try</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <systemPropertyVariables>
            <!-- The fixtures digline's Python writes, read by both sides. -->
            <digline.fixtures>${project.basedir}/../fixtures</digline.fixtures>
            <digline.page>${project.basedir}/../../docs/record-java.md</digline.page>
          </systemPropertyVariables>
          <!--
            What the page's clients read from the environment, `fromEnv()` and
            the AWS SDK's own variables: fake providers on fixed ports of
            127.0.0.1, which PageTest starts. A key here opens nothing.
          -->
          <environmentVariables>
            <OPENAI_API_KEY>page</OPENAI_API_KEY>
            <OPENAI_BASE_URL>http://127.0.0.1:18787/v1</OPENAI_BASE_URL>
            <ANTHROPIC_API_KEY>page</ANTHROPIC_API_KEY>
            <ANTHROPIC_BASE_URL>http://127.0.0.1:18789</ANTHROPIC_BASE_URL>
            <AWS_REGION>us-east-1</AWS_REGION>
            <AWS_ACCESS_KEY_ID>page</AWS_ACCESS_KEY_ID>
            <AWS_SECRET_ACCESS_KEY>page</AWS_SECRET_ACCESS_KEY>
            <AWS_ENDPOINT_URL_BEDROCK_RUNTIME>http://127.0.0.1:18788</AWS_ENDPOINT_URL_BEDROCK_RUNTIME>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
