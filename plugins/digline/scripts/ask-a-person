#!/bin/sh
# PreToolUse on Bash: a command that runs `digline promote` or `digline register`
# goes to a person.
#
# Both write a person's judgement into a committed file: `promote` makes a run
# the approved reference, `register` records what somebody decided about a
# comparison. AGENTS.md rule 1 holds each to the same rule — never on the
# agent's own initiative.
#
# `ask`, never `deny`: AGENTS.md lets the human run it *or tell the agent to*,
# and a deny would refuse the second. The prompt this raises is that person's
# moment to approve.
#
# This is a preference, not a wall. Whoever can disable the plugin or edit the
# settings it lives in can remove it, and a command spelled in a way this
# pattern does not read goes through. The wall is the reviewed diff under
# `.digline/<tenant>/`, which is committed — this only makes the honest path
# the easy one.
#
# The whole payload is matched rather than the command field alone: a sh script
# cannot parse JSON reliably, and a false positive costs one extra prompt.

payload=$(cat)

names() {
    printf '%s' "$payload" |
        grep -Eq '(^|[^[:alnum:]_-])digline(\.cli)?( [^"|;&]*)? '"$1"'([^[:alnum:]_-]|$)'
}

if names promote; then
    what="digline promote makes a run the approved reference, committed under .digline/<tenant>/baselines/"
elif names register; then
    what="digline register records what a person decided about a comparison, committed under .digline/<tenant>/register/"
else
    exit 0
fi

printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "ask", "permissionDecisionReason": "%s. That decision is a person'"'"'s: approve this only if you made it. (A preference, not a wall - the wall is the reviewed diff.)"}}\n' "$what"
exit 0
